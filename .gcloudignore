# This file specifies files that are *not* uploaded to Google Cloud
# using gcloud. It follows the same syntax as .gitignore

.gcloudignore
.git
.gitignore
README.md
.env
.env.local
*.pyc
__pycache__/
*.log
db.sqlite3
media/
staticfiles/
venv/
env/
.venv/
.vscode/
.idea/
*.swp
*.swo
service-account-key.json

