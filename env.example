# ============================================
# GREWECO Backend Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# For Google Cloud deployment, set these in Cloud Run environment variables

# ============================================
# Django Core Settings
# ============================================
SECRET_KEY=your-secret-key-here-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,your-cloud-run-url.run.app

# ============================================
# Database Configuration
# ============================================
# Local PostgreSQL (for development)
DATABASE_NAME=greweco_db
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_HOST=localhost
DATABASE_PORT=5432

# Google Cloud SQL (for production)
# Set USE_CLOUD_SQL=True to use Cloud SQL
USE_CLOUD_SQL=False
CLOUD_SQL_CONNECTION_NAME=project:region:instance
# Example: my-project:us-central1:greweco-db

# ============================================
# Google Cloud Storage
# ============================================
GS_BUCKET_NAME=greweco-certificates
# For local development, you can use a service account key file:
GOOGLE_APPLICATION_CREDENTIALS=path/to/service-account-key.json
# For Cloud Run, leave empty - uses default service account
# GOOGLE_APPLICATION_CREDENTIALS=

# Google Cloud Project ID (for GCS operations)
GOOGLE_CLOUD_PROJECT_ID=your-gcp-project-id

# ============================================
# JWT Authentication
# ============================================
# Optional: Override JWT secret (defaults to SECRET_KEY)
JWT_SECRET_KEY=your-jwt-secret-key-here

# ============================================
# CORS Configuration
# ============================================
# Frontend URLs (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://your-frontend-domain.com

# ============================================
# Google Maps API (for future use)
# ============================================
GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# ============================================
# Google Cloud Run Configuration
# ============================================
# Port for Cloud Run (default: 8080)
PORT=8080

# ============================================
# Cloud Scheduler / Background Jobs
# ============================================
# Optional: Secret token for Cloud Scheduler HTTP triggers
CLOUD_SCHEDULER_SECRET=your-secret-token-for-scheduler

# ============================================
# Email Configuration (for future use)
# ============================================
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=your-email@gmail.com
# EMAIL_HOST_PASSWORD=your-app-password

# ============================================
# Logging (for production)
# ============================================
# LOG_LEVEL=INFO
# LOG_FILE=/var/log/greweco-back.log

# ============================================
# Security (for production)
# ============================================
# SECURE_SSL_REDIRECT=True
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True

